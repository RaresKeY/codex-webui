# No credentials belong in this file or the container image.
CODEX_WEBUI_PORT=8766
CODEX_WEBUI_IMAGE=localhost/codex-webui-2:local
# Override with an absolute path to the narrowest useful workspace ancestor.
# CODEX_WEBUI_WORKSPACE_ROOT=/absolute/workspace
# External read-only file containing JEV_API or TYPESAFE_API_KEY.
# CODEX_WEBUI_JEV_KEY_FILE=/absolute/path/to/jev.env

# Experimental: private Unix socket provided by the restricted host browser bridge.
# CODEX_WEBUI_BROWSER_BRIDGE_SOCKET=/run/browser-bridge/bridge.sock
CODEX_WEBUI_BROWSER_ENABLED=true
