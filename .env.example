APP_VERSION=0.1.0
CODEX_VERSION=0.145.0
# Keep these defaults to build locally. For the prebuilt image, use
# ghcr.io/rareskey/codex-webui and either latest or a published sha-* tag.
CODEX_WEBUI_IMAGE=codex-webui
CODEX_WEBUI_IMAGE_TAG=0.1.0
CODEX_WEBUI_BIND=127.0.0.1
CODEX_WEBUI_PORT=8765
# Must be absolute and must match the path used by host-side Codex CLI.
# tools/bootstrap.sh replaces this example with a safe local absolute path.
CODEX_WORKSPACES=/home/pi/RawProjects
PUID=1000
PGID=1000
DEFAULT_APPROVAL_POLICY=on-request
DEFAULT_SANDBOX=workspace-write
CODEX_WEBUI_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
CODEX_WEBUI_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# Deliberately disabled by default. If enabled, point this at a tightly scoped,
# host-managed updater rather than exposing the Docker socket to the web app.
CODEX_WEBUI_UPDATE_COMMAND=
