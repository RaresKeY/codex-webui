FROM ghcr.io/denoland/deno:bin-2.9.7@sha256:6e4bc7aed62e400bb3f1bbea561da91e7abc02e1dbc5c3db38af78c3624f2760 AS deno-bin
FROM docker.io/library/python:3.12-slim@sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17
COPY --from=deno-bin /deno /usr/local/bin/deno
COPY tools/workspace-package.json /app/package.json
ENV DENO_DIR=/tmp/deno-cache DENO_NO_UPDATE_CHECK=1 DENO_NO_PROMPT=1
USER 1000:1000
WORKDIR /app
